# ── Supabase (Vercel 서버 함수가 쓴다. 브라우저로 절대 노출되지 않는다) ────────
# Supabase 대시보드 → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 대본 생성 서버 키 (선택. 없으면 내장 문장 엔진이 대본을 쓴다) ──────────────
OPENAI_API_KEY=
OPENAI_SCRIPT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_SCRIPT_MODEL=claude-sonnet-4-5

# ── 내장 엔진 (CLI·로컬 실행용 — Vercel 배포에는 불필요) ───────────────────────
TTS_PROVIDER=local
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
