# ── Script generation (optional) ─────────────────────────────────────────────
# Without a key the engine runs its deterministic heuristic writer.
OPENAI_API_KEY=
OPENAI_SCRIPT_MODEL=gpt-4o-mini

# ── Voice-over (optional) ────────────────────────────────────────────────────
# elevenlabs = word timestamps from character alignment, openai = estimated
# alignment, local = offline synthetic voice (development & CI)
TTS_PROVIDER=local
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# ── Instagram Content Publishing (Meta Graph API) ────────────────────────────
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0

# ── YouTube Data API v3 ──────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CATEGORY_ID=22

# ── Rendering ────────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
