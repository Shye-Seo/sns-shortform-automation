{
  "name": "shye-seo/shortform-backend",
  "description": "shortform-engine B2B backend — PHP 8.2 API/worker layer for the durable render queue, Meta Graph publishing and Naver Cloud SENS alimtalk",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Seunghye Seo",
      "email": "tjtmdgp95@gmail.com",
      "role": "Backend · Data Modeling"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Shortform\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Shortform\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "migrate": "php bin/migrate.php",
    "worker": "php bin/worker.php",
    "serve": "php -S 127.0.0.1:8081 -t public"
  },
  "config": {
    "sort-packages": true
  }
}
