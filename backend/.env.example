# shortform backend environment (.env.example → .env)
# Never commit real keys: .env is gitignored.

APP_ENV=local
APP_DEBUG=true

# MySQL 8.0 (queue state, projects, publish logs)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shortform
DB_USERNAME=shortform
DB_PASSWORD=change-me
DB_UNIX_SOCKET=
DB_TIMEZONE=+09:00

# Meta / Instagram Graph API
IG_GRAPH_VERSION=v21.0
IG_APP_SECRET=
IG_VERIFY_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# Naver Cloud Platform SENS (kakao alimtalk)
SENS_ACCESS_KEY=
SENS_SECRET_KEY=
SENS_SERVICE_ID=
SENS_PLUS_FRIEND_ID=@shortform
SENS_TEMPLATE_RENDER_DONE=SF_RENDER_DONE
SENS_TEMPLATE_PUBLISH_DONE=SF_PUBLISH_DONE
SENS_TEMPLATE_PUBLISH_FAILED=SF_PUBLISH_FAILED
SENS_TEMPLATE_QUOTA_EXHAUSTED=SF_QUOTA_EXHAUSTED
SENS_FAILOVER_FROM=
SENS_BASE_URL=https://sens.apigw.ntruss.com

# Worker
WORKER_CONCURRENCY=3
WORKER_LEASE_SECONDS=300

# Comment → DM coupon pipeline (bin/coupon-worker.php, /webhooks/instagram comments)
COUPON_SENDER=dryrun          # dryrun (no external calls) | live | auto
COUPON_TOKEN_SIGNING_KEY=     # required in production; signs one-time claim links
COUPON_TOKEN_SIGNING_KEY_OLD= # previous key, kept valid during the 15 min TTL after rotation
COUPON_HASH_KEY=              # HMAC key for author ids in the event ledger (defaults to the signing key)
COUPON_DEEP_LINK_BASE=https://coupon.shye.kr/c
COUPON_SLA_SECONDS=5
COUPON_MAX_ATTEMPTS=5
COUPON_WORKER_LEASE_SECONDS=120
SENS_TEMPLATE_COUPON=COUPON_CLAIM_V1
