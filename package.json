{
  "name": "shortform-engine",
  "version": "2.0.0",
  "description": "Distributed render queue and multi-tenant shortform publishing platform: priority queue with DLQ, Redis adapter, token-bucket rate limits, OAuth rotation, jittered slots, hook A/B telemetry and a studio console with time-series metrics",
  "license": "MIT",
  "author": "Seunghye Seo <tjtmdgp95@gmail.com> (https://github.com/Shye-Seo)",
  "homepage": "https://github.com/Shye-Seo/sns-shortform-automation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shye-Seo/sns-shortform-automation.git"
  },
  "keywords": [
    "shortform",
    "reels",
    "shorts",
    "distributed-queue",
    "job-queue",
    "dlq",
    "rate-limiting",
    "multi-tenant",
    "oauth2",
    "ab-testing",
    "observability",
    "instagram-graph-api",
    "youtube-data-api",
    "ffmpeg",
    "audio-ducking",
    "subtitles",
    "typescript",
    "metrics",
    "time-series",
    "svg-chart",
    "redis",
    "observability"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "shortform": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts craft --topic \"부산 신혼집 3평 주방 수납 정리법\" --out .work/demo --lang ko --duration 45",
    "demo:queue": "tsx src/cli.ts queue run --jobs 11 --concurrency 3 --fail-every 7 --state .work/queue/state.json",
    "demo:studio": "tsx src/cli.ts studio --html .work/studio.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "verify": "npm run typecheck && npm run lint && npm test",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.2",
    "eslint": "^8.57.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
