{
  "name": "shortform-engine",
  "version": "1.0.0",
  "description": "Human-in-the-loop 60s shortform engine: beat-structured scripts, word-level subtitle sync, audio ducking, 9:16 render, and official Reels/Shorts publishing",
  "license": "MIT",
  "author": "Seunghye Seo <tjtmdgp95@gmail.com> (https://github.com/Shye-Seo)",
  "homepage": "https://github.com/Shye-Seo/sns-shortform-automation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shye-Seo/sns-shortform-automation.git"
  },
  "keywords": [
    "shortform",
    "reels",
    "shorts",
    "instagram-graph-api",
    "youtube-data-api",
    "ffmpeg",
    "audio-ducking",
    "subtitles",
    "typescript"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "shortform": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts craft --topic \"부산 신혼집 3평 주방 수납 정리법\" --out .work/demo --lang ko --duration 45",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "verify": "npm run typecheck && npm run lint && npm test",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.2",
    "eslint": "^8.57.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
